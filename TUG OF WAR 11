n = int(input())
a = list(map(int, input().split()))
total = sum(a)
ans = total
def find(i, count, s):
    global ans
    if count == n // 2:
        ans = min(ans, abs(total - 2 * s))
        return
    if i == n:
        return
    find(i + 1, count + 1, s + a[i])
    find(i + 1, count, s)
find(0, 0, 0)
print(ans)
