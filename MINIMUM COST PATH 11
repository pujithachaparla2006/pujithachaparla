n, m = map(int, input().split())
a = []
for i in range(n):
    a.append(list(map(int, input().split())))
for i in range(n):
    for j in range(m):
        if i == 0 and j == 0:
            continue
        if i == 0:
            a[i][j] += a[i][j - 1]
        elif j == 0:
            a[i][j] += a[i - 1][j]
        else:
            a[i][j] += min(
                a[i - 1][j],
                a[i][j - 1],
                a[i - 1][j - 1]
            )
print(a[n - 1][m - 1])
